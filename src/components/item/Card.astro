---
import type { HTMLAttributes } from "astro/types";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Img from "@/components/media/Img.astro";
import Overlay from "@/components/media/Overlay.astro";
import { slotContent } from "@/utils/slots.ts";

type ImageSource = ImageMetadata | string;

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Eyebrow text. Supports inline markup. */
  eyebrow?: string;
  /** Card title. Supports inline markup. */
  heading?: string;
  /** Heading level. */
  headingTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Body text. Supports inline markup. */
  text?: string;
  /** Button label. Omit to hide the button. */
  buttonLabel?: string;
  /** Button destination. Omit for a `<button>`. */
  buttonHref?: string;
  /** Card layout. */
  variant?: "default" | "cover" | "stacked" | "graphic" | "quote" | "stat";
  /** Color theme of element and its children. */
  theme?: "inherit" | "light" | "dark" | "brand" | "invert";
};

type Props = Base &
  (
    | {
        variant?: "default";
        image?: never;
        imageAlt?: never;
      }
    | {
        variant: "graphic";
        image?: never;
        imageAlt?: never;
      }
    | {
        variant: "quote";
        /** Who said it. */
        cite?: string;
        /** Add the glow at the foot of the card. */
        accent?: boolean;
        image?: never;
        imageAlt?: never;
      }
    | {
        variant: "stat";
        /** Headline figure, such as `80%`. */
        value?: string;
        image?: never;
        imageAlt?: never;
      }
    | {
        variant: "cover";
        /** Image source. */
        image?: ImageSource;
        /** Image alt text. Omit for decorative images. */
        imageAlt?: string;
      }
    | {
        variant: "stacked";
        /** Color theme of element and its children. */
        theme?: never;
        /** Image source. */
        image?: ImageSource;
        /** Image alt text. Omit for decorative images. */
        imageAlt?: string;
      }
  );

type AllProps = Base & {
  cite?: string;
  accent?: boolean;
  value?: string;
  image?: ImageSource;
  imageAlt?: string;
};

const {
  render = true,
  eyebrow,
  heading,
  headingTag = "h3",
  text,
  buttonLabel,
  buttonHref,
  variant = "default",
  cite,
  accent = false,
  value,
  theme = "inherit",
  image,
  imageAlt,
  class: className,
  ...rest
} = Astro.props as AllProps;

const visual = await slotContent(Astro.slots);
const isSurface = variant === "quote" || variant === "stat";
const hasImage =
  variant !== "default" && variant !== "graphic" && !isSurface && !!image;
const hasVisual = variant === "graphic" && !!visual;
const hasContent = !!(eyebrow || heading || text || buttonLabel || value);
const hasTheme = variant !== "stacked" && theme !== "inherit";

/* The button each variant closes with, so a set of cards reads as one system.
   A link carries no emphasis of its own, so the two are picked together. */
const buttonKind =
  variant === "stacked"
    ? ({ variant: "link" } as const)
    : ({ emphasis: variant === "cover" ? "primary" : "secondary" } as const);

if (import.meta.env.DEV && render) {
  if (variant === "stacked" && theme !== "inherit") {
    console.warn(
      '[lumos] <Card variant="stacked"> has no surface to color, so `theme` was dropped. It keeps the theme around it.',
    );
  }
  if (variant === "default" && image) {
    console.warn(
      '[lumos] <Card variant="default"> holds no image, so `image` was dropped. Use the cover or stacked variant to show it.',
    );
  }
  if (variant !== "default" && variant !== "graphic" && !isSurface && !image) {
    console.warn(
      `[lumos] <Card variant="${variant}"> has no \`image\`, so it renders as a plain card.`,
    );
  }
}
---

{
  render && (hasContent || hasImage || hasVisual) && (
    <div
      class:list={[
        "card_wrap",
        variant !== "default" && variant,
        hasTheme && `theme-${theme}`,
        accent && "accent",
        className,
      ]}
      {...rest}
    >
      {hasImage && (
        <div class="card_visual">
          <Img src={image!} alt={imageAlt} />
          {variant === "cover" && <Overlay variant="gradient" />}
        </div>
      )}
      {hasVisual && (
        <div class="card_visual">
          <Fragment set:html={visual} />
        </div>
      )}
      {isSurface && <span class="card_glow" aria-hidden="true" />}
      {hasContent && variant === "quote" && (
        <div class="card_content margin-trim">
          <Paragraph class="card_quote" variant="large" data-motion="lines">
            <Fragment set:html={text} />
          </Paragraph>
          <Paragraph class="card_cite" variant="small" data-motion="lift">
            <Fragment set:html={cite} />
          </Paragraph>
          <ButtonWrapper data-motion="lift">
            <Button element="link" href={buttonHref} emphasis="secondary">
              {buttonLabel}
            </Button>
          </ButtonWrapper>
        </div>
      )}
      {hasContent && variant === "stat" && (
        <div class="card_content margin-trim">
          <p class="card_value text-style-h2">{value}</p>
          <div class="card_caption margin-trim">
            <Heading tag={headingTag} variant="h6">
              <Fragment set:html={heading} />
            </Heading>
            <Paragraph variant="large">
              <Fragment set:html={text} />
            </Paragraph>
          </div>
        </div>
      )}
      {hasContent && !isSurface && (
        <div class="card_content margin-trim">
          <Eyebrow>
            <Fragment set:html={eyebrow} />
          </Eyebrow>
          <Heading tag={headingTag} variant="h5">
            <Fragment set:html={heading} />
          </Heading>
          <Paragraph>
            <Fragment set:html={text} />
          </Paragraph>
          <ButtonWrapper>
            {buttonHref ? (
              <Button element="link" href={buttonHref} {...buttonKind}>
                {buttonLabel}
              </Button>
            ) : (
              <Button {...buttonKind}>{buttonLabel}</Button>
            )}
          </ButtonWrapper>
        </div>
      )}
    </div>
  )
}

<style is:global>
  @layer components {
    .card_wrap {
      --_padding: var(--space-6);
      --_min-height: 20rem;
      --_visual-ratio: 3 / 2;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--_padding);
      position: relative;
      background-color: var(--background-2);
      border-radius: var(--radius-main);
      overflow: clip;

      &.cover {
        min-height: var(--_min-height);
      }
      &.stacked {
        background-color: transparent;
        overflow: visible;
      }
      &:is(.quote, .stat) {
        --_padding: var(--space-5);
        min-height: 14rem;
        background-color: var(--white);
        border: var(--border-width) solid var(--orange-100);
        border-radius: var(--radius-large);
        box-shadow:
          inset 0 0 0 0.25rem var(--white),
          0 0.1875rem 0.375rem
            color-mix(in lab, var(--neutral-200) 60%, transparent),
          0 1.125rem 2.25rem
            color-mix(in lab, var(--neutral-700) 6%, transparent);
        transition: translate 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
        & > .card_content {
          position: relative;
        }
        @media (hover: hover) {
          &:hover {
            translate: 0 -0.25rem;
            & > .card_glow {
              opacity: 1;
            }
          }
        }
      }
      &.quote {
        min-height: 20.25rem;
        &.accent::before {
          content: "";
          position: absolute;
          inset: 55% 0 0;
          background-image:
            radial-gradient(circle, var(--white) 0.06rem, transparent 0.08rem),
            radial-gradient(
              ellipse 60% 90% at 45% 100%,
              color-mix(in lab, var(--orange-300) 40%, transparent),
              transparent 70%
            );
          background-size:
            0.45rem 0.45rem,
            auto;
          pointer-events: none;
        }
        & .card_cite {
          margin-top: var(--space-2);
          color: var(--text-2);
        }
      }
      &.stat {
        & > .card_content {
          justify-content: space-between;
          gap: var(--space-5);
        }
        & .heading {
          margin-bottom: var(--space-1);
        }
        & .text {
          color: var(--text-2);
        }
      }
      &.graphic {
        --_padding: var(--space-5);
        padding: var(--_padding);
        background-color: var(--background-3);
        border-radius: var(--radius-large);
        & > .card_visual {
          overflow: visible;
          border-radius: 0;
        }
        & > .card_content {
          padding: 0;
          & .heading {
            margin-bottom: var(--space-1);
          }
          & .text {
            color: var(--text-2);
          }
        }
      }
    }

    .card_value {
      margin: 0;
      font-variant-numeric: tabular-nums;
    }

    .card_glow {
      position: absolute;
      top: 0;
      left: 0;
      width: 18rem;
      height: 18rem;
      background-image: radial-gradient(
        circle closest-side,
        color-mix(in lab, var(--orange-300) 28%, transparent),
        transparent
      );
      opacity: 0;
      pointer-events: none;
      translate: calc(var(--_x, 50%) - 50%) calc(var(--_y, 50%) - 50%);
      transition: opacity 300ms var(--hover-ease);
    }

    .card_visual {
      position: relative;
      width: 100%;
      flex: none;
      border-radius: inherit;
      overflow: clip;

      .stacked > & {
        aspect-ratio: var(--_visual-ratio);
      }

      .cover > & {
        position: absolute;
        inset: 0;
        height: 100%;
        pointer-events: none;
      }

      > :is(.image, .video) {
        width: 100%;
        height: 100%;
      }
    }

    /* Media fills its box, be that the whole card or the band across its top.
       The component layer puts this above the `height: auto` every image and
       video starts from. */
    .card_visual > :is(.image, .video) {
      width: 100%;
      height: 100%;
    }

    /* Buttons closing a card sit on its floor, however tall the row around it
       grows. This outranks the margin `.button-wrapper` sets for itself. */
    .card_content > .button-wrapper:last-child {
      margin-top: auto;
      padding-top: var(--space-6);
    }

    .card_content {
      display: flex;
      flex-direction: column;
      align-items: var(--_alignment, start);
      text-align: var(--_alignment, start);
      flex-grow: 1;
      width: 100%;
      max-width: 100%;
      padding: var(--_padding);

      .cover > & {
        z-index: 1;
      }

      .stacked > & {
        padding-inline: 0;
        padding-top: 0;
      }
    }

    .card_wrap:has(.button_wrap) {
      .button_wrap::after {
        content: "";
        position: absolute;
        inset: 0;
      }

      .card_content a:not(.button_wrap) {
        position: relative;
        z-index: 1;
      }

      .image {
        transition: scale calc(var(--hover-duration) * 2) var(--hover-ease);
      }

      @media (hover: hover) {
        &:hover .image {
          scale: 1.04;
        }
      }
    }
  }
</style>
