---
import Icon from "@/components/media/Icon.astro";
import Button from "@/components/Button.astro";
import NavLink from "@/components/global/NavLink.astro";
import mark from "@/assets/logo/acerna-mark.svg";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_inner">
        <a class="nav_logo" href="/" aria-label={SITE_NAME}>
          <Icon src={mark} />
          <span>acerna</span>
        </a>
        <button
          class="nav_toggle"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <span class="nav_toggle_icon" />
        </button>
        <nav class="nav_menu" id="nav-menu" aria-label="Main">
          <div class="nav_menu_inner">
            <ul class="nav_links">
              <NavLink href="/pricing">Pricing</NavLink>
              <NavLink href="/integrations">Integrations</NavLink>
              <NavLink href="/blog">Blog</NavLink>
              <NavLink href="/case-studies">Case Studies</NavLink>
              <NavLink href="/contact">Contact</NavLink>
            </ul>
            <Button element="link" href="/contact" emphasis="secondary">
              Book a Demo
            </Button>
          </div>
        </nav>
      </div>
    </header>
  )
}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      visibility: visible;
      opacity: 1;
      transform: none;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 48rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: transparent;
      color: var(--text);

      /* Bar surface */
      &::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background-color: color-mix(in lab, var(--background) 40%, transparent);
        backdrop-filter: blur(1rem);
        border-bottom: var(--border-width) solid var(--border);
      }

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }

      &.open::before {
        background-color: var(--background);
      }
    }

    /* Clear over the first section, surfaced once the page moves */
    @supports (animation-timeline: scroll()) {
      .nav_wrap.overlap:not(.open)::before {
        opacity: 0;
        animation: nav-surface linear both;
        animation-timeline: scroll(root);
        animation-range: 0 var(--nav-height);
      }
    }

    @keyframes nav-surface {
      to {
        opacity: 1;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-5);
    }

    /* Bar height */
    .nav_logo,
    .nav_toggle {
      min-height: var(--nav-height);
    }

    .nav_logo {
      display: flex;
      align-items: center;
      gap: 0.17em;
      font-size: 1.5rem;
      font-weight: var(--primary-medium);
      line-height: var(--line-height-small);
      letter-spacing: var(--letter-spacing-tight);
      transition: opacity var(--hover-duration) var(--hover-ease);
      & .icon {
        --_size: 0.835em;
      }
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-0.5rem);
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      border-bottom: var(--border-width) solid var(--border);
      transition:
        opacity var(--open-duration) var(--open-ease),
        transform var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .nav_menu_inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-2) var(--site-margin) var(--space-5);
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      font-size: var(--text-main);
      font-weight: var(--primary-medium);
      & > li + li {
        border-top: var(--border-width) solid var(--border);
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      border-radius: var(--radius-small);
      color: var(--text);
      text-decoration: none;
    }

    @media (width >= 48rem) {
      .nav_toggle {
        display: none;
      }

      .nav_menu {
        position: static;
        flex: 1;
        visibility: visible;
        opacity: 1;
        transform: none;
        max-height: none;
        overflow: visible;
        background-color: transparent;
        border-bottom: 0;
      }

      .nav_menu_inner {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 0;
      }

      .nav_links {
        flex-direction: row;
        align-items: center;
        gap: 0.25rem;
        font-size: var(--text-small);
        line-height: var(--line-height-small);
        letter-spacing: var(--letter-spacing-tight);
        & > li + li {
          border-top: 0;
        }
      }

      .nav_link {
        padding: 0.5rem;
        &[aria-current="page"] {
          background-color: var(--background-2);
        }
        @media (hover: hover) {
          &:hover {
            background-color: var(--background-2);
          }
        }
      }
    }
  }
</style>
