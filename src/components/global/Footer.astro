---
import Icon from "@/components/media/Icon.astro";
import Button from "@/components/Button.astro";
import mark from "@/assets/logo/acerna-mark.svg";
import socialX from "@/assets/icons/social-x.svg";
import socialLinkedin from "@/assets/icons/social-linkedin.svg";
import socialInstagram from "@/assets/icons/social-instagram.svg";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const columns = [
  {
    title: "Features",
    links: [
      { label: "Policy Controls", href: "/#features" },
      { label: "Transaction Guards", href: "/#features" },
      { label: "Automated Checkout", href: "/#features" },
      { label: "Compliance", href: "/#features" },
    ],
  },
  {
    title: "Others",
    links: [
      { label: "Pricing", href: "/pricing" },
      { label: "Integrations", href: "/integrations" },
      { label: "Blog", href: "/blog" },
      { label: "Case Studies", href: "/case-studies" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "Terms", href: "/terms" },
      { label: "Privacy", href: "/privacy" },
      { label: "Contact", href: "/contact" },
    ],
  },
];

const socials = [
  { label: "X", href: "#", icon: socialX },
  { label: "LinkedIn", href: "#", icon: socialLinkedin },
  { label: "Instagram", href: "#", icon: socialInstagram },
];
---

{
  render && (
    <footer class="footer_wrap">
      <div class="footer_inner">
        <div class="footer_top">
          <nav class="footer_columns" aria-label="Footer">
            {columns.map((column) => (
              <div class="footer_column">
                <p class="footer_label">{column.title}</p>
                <ul class="footer_links" role="list">
                  {column.links.map((link) => (
                    <li>
                      <a class="footer_link" href={link.href}>
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
          <div class="footer_column">
            <p class="footer_label">Stay Connected</p>
            <ul class="footer_socials" role="list">
              {socials.map((social) => (
                <li>
                  <a
                    class="footer_social"
                    href={social.href}
                    aria-label={social.label}
                  >
                    <Icon src={social.icon} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="footer_bottom">
          <div class="footer_brand">
            <a class="footer_logo" href="/" aria-label={SITE_NAME}>
              <Icon src={mark} />
              <span>acerna</span>
            </a>
            <p class="footer_tagline">
              The AI backbone for financial workflows: compliance, approvals
              and automation in one platform.
            </p>
            <Button element="link" href="/contact">
              Book a Demo
            </Button>
          </div>
          <p class="footer_copyright">
            &copy; <span id="year">{new Date().getFullYear()}</span>&#160;
            {SITE_NAME}. All rights reserved.
          </p>
        </div>
      </div>
      <div class="footer_wordmark" aria-hidden="true">
        <div class="footer_wordmark_inner">
          <Icon src={mark} />
          <span>acerna</span>
        </div>
      </div>
    </footer>
  )
}

<script>
  const year = document.querySelector<HTMLSpanElement>("#year");

  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      --_ease: cubic-bezier(0.2, 0.7, 0.2, 1);
      container-type: inline-size;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-7);
      padding-top: var(--section-space-small);
      overflow: clip;
      background-color: var(--background);
      color: var(--text);
      border-top: var(--border-width) solid var(--border);
    }

    .footer_inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      width: var(--site-width);
      max-width: var(--max-width-main);
    }

    .footer_top {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-6);
    }

    .footer_columns {
      flex: 1;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6) var(--space-4);
      min-width: min(100%, 18rem);
      max-width: 40rem;
      @media (width >= 48rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .footer_column {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .footer_label {
      margin: 0;
      color: var(--neutral-700);
      font-size: var(--text-small);
      font-weight: var(--primary-bold);
      line-height: var(--text-small-line-height);
    }

    .footer_links {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .footer_link {
      position: relative;
      display: inline-block;
      color: var(--neutral-900);
      font-weight: var(--primary-bold);
      text-decoration: none;
      transition: translate 250ms var(--_ease);
      &::after {
        content: "";
        position: absolute;
        right: 0;
        bottom: -0.125rem;
        left: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transform-origin: left;
        scale: 0 1;
        transition: scale 300ms var(--_ease);
      }
      @media (hover: hover) {
        &:hover {
          translate: 0.25rem 0;
          &::after {
            scale: 1 1;
          }
        }
      }
    }

    .footer_socials {
      display: flex;
      gap: var(--space-1);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .footer_social {
      display: grid;
      place-items: center;
      width: 2.125rem;
      height: 2.125rem;
      background-color: var(--neutral-1000);
      border-radius: 50%;
      color: var(--white);
      transition:
        translate 250ms var(--_ease),
        scale 250ms var(--_ease);
      & .icon {
        --_size: 1.125rem;
      }
      @media (hover: hover) {
        &:hover {
          translate: 0 -0.1875rem;
          scale: 1.08;
        }
      }
    }

    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-4);
    }

    .footer_brand {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
      max-width: 20rem;
    }

    .footer_logo {
      display: flex;
      align-items: center;
      gap: 0.17em;
      color: inherit;
      font-size: 1.5rem;
      font-weight: var(--primary-medium);
      line-height: var(--line-height-small);
      letter-spacing: var(--letter-spacing-tight);
      text-decoration: none;
      transition: opacity var(--hover-duration) var(--hover-ease);
      & .icon {
        --_size: 0.835em;
        color: var(--orange-500);
      }
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .footer_tagline,
    .footer_copyright {
      margin: 0;
      color: var(--text-2);
    }

    /* Wordmark */
    .footer_wordmark {
      width: 100%;
      height: 12.5cqw;
      overflow: clip;
      mask-image: linear-gradient(black, transparent 95%);
    }

    .footer_wordmark_inner {
      display: flex;
      align-items: flex-start;
      justify-content: center;
      gap: 0.17em;
      color: color-mix(in lab, var(--orange-300) 24%, var(--white));
      font-size: 24cqw;
      font-weight: var(--primary-medium);
      line-height: 0.8;
      letter-spacing: var(--letter-spacing-tight);
      white-space: nowrap;
      & .icon {
        --_size: 0.835em;
        opacity: 0.3;
      }
    }

    /* Motion */
    .footer_wrap {
      @media (prefers-reduced-motion: no-preference) {
        @supports (animation-timeline: view()) {
          & :is(.footer_column, .footer_bottom) {
            animation: footer-rise linear both;
            animation-timeline: view();
            animation-range: entry 0% entry 90%;
          }
          & .footer_wordmark_inner {
            animation: footer-surface linear both;
            animation-timeline: view();
            animation-range: entry 0% entry 100%;
          }
        }
      }
    }

    @keyframes footer-rise {
      from {
        opacity: 0;
        translate: 0 1.5rem;
      }
    }

    @keyframes footer-surface {
      from {
        opacity: 0;
        translate: 0 45%;
      }
    }
  }
</style>
