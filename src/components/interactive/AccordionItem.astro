---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/typography/Heading.astro";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow.svg";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"details"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Item heading. */
  heading?: string;
  /** Heading level. */
  headingTag?: "h2" | "h3" | "h4" | "h5" | "h6";
  /** Item layout. */
  variant?: "default" | "card";
  /** Open on load. */
  open?: boolean;
};

const {
  render = true,
  heading,
  headingTag = "h3",
  variant = "default",
  open = false,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && heading && content && (
    <details
      class:list={[
        "accordion_item",
        variant !== "default" && variant,
        className,
      ]}
      open={open}
      data-accordion-group
      {...rest}
    >
      <summary class="accordion_toggle">
        <Heading
          tag={headingTag}
          variant={variant === "card" ? "large" : "h5"}
          class="accordion_title"
        >
          {heading}
        </Heading>
        <Icon class="accordion_icon" src={arrow} variant="small" />
      </summary>

      <div class="accordion_body margin-trim">
        <Fragment set:html={content} />
      </div>
    </details>
  )
}

<style is:global>
  @layer components {
    .accordion_item {
      interpolate-size: allow-keywords;
      border-bottom: var(--border-width) solid var(--border);
      transition: border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          border-bottom-color: currentcolor;
        }
      }
    }

    .accordion_toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding-block: var(--space-5);
      list-style: none;
      cursor: pointer;
      &::-webkit-details-marker {
        display: none;
      }
    }

    .accordion_title {
      margin-block: 0;
    }

    .accordion_icon {
      rotate: 90deg;
      transition: rotate var(--open-duration) var(--open-ease);
    }

    .accordion_item:is([open], .stacki-opened) .accordion_icon,
    .stacki-designer .accordion_wrap.preview .accordion_icon {
      rotate: -90deg;
    }

    .accordion_item::details-content {
      block-size: 0;
      overflow: hidden;
      content-visibility: hidden;
      transition:
        block-size var(--open-duration) var(--open-ease),
        content-visibility var(--open-duration) var(--open-ease) allow-discrete;
    }

    .accordion_item:is([open], .stacki-opened)::details-content,
    .stacki-designer .accordion_wrap.preview .accordion_item::details-content {
      block-size: auto;
      content-visibility: visible;
    }

    .accordion_body {
      padding-bottom: var(--space-5);
    }

    /* Card */
    .accordion_wrap:has(> .accordion_item.card) {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      width: 100%;
    }

    .accordion_item.card {
      background-color: var(--white);
      border: var(--border-width) solid var(--orange-100);
      border-radius: var(--radius-small);
      box-shadow: 0 0.1875rem 0.375rem
        color-mix(in lab, var(--neutral-200) 50%, transparent);
      transition:
        border-color var(--hover-duration) var(--hover-ease),
        translate 300ms cubic-bezier(0.2, 0.7, 0.2, 1);
      & .accordion_toggle {
        padding: 1.125rem var(--space-4);
      }
      & .accordion_title {
        font-weight: var(--primary-medium);
      }
      & .accordion_icon {
        transition:
          rotate var(--open-duration) var(--open-ease),
          translate 300ms cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      & .accordion_body {
        padding: 0 calc(var(--space-4) * 2 + 1rem) 1.25rem var(--space-4);
        color: var(--text-2);
        opacity: 0;
        translate: 0 -0.5rem;
        transition:
          opacity 300ms var(--open-ease),
          translate 300ms var(--open-ease);
      }
      &[open] .accordion_body {
        opacity: 1;
        translate: 0 0;
        transition-delay: 80ms;
        @starting-style {
          opacity: 0;
          translate: 0 -0.5rem;
        }
      }
      @media (hover: hover) {
        &:hover {
          border-color: var(--orange-300);
          translate: 0 -0.125rem;
          & .accordion_icon {
            translate: 0 0.1875rem;
          }
        }
      }
      @media (prefers-reduced-motion: reduce) {
        & .accordion_body {
          opacity: 1;
          translate: none;
          transition: none;
        }
      }
    }
  }
</style>
