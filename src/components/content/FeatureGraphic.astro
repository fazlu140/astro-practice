---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import Img from "@/components/media/Img.astro";
import danger from "@/assets/graphics/hero/danger.svg";
import policyApproved from "@/assets/graphics/features/policy-approved.svg";
import policyBlocked from "@/assets/graphics/features/policy-blocked.svg";
import policyPending from "@/assets/graphics/features/policy-pending.svg";
import policyBlockedSmall from "@/assets/graphics/features/policy-blocked-small.svg";
import avatarJohn from "@/assets/graphics/features/avatar-john.png";
import avatarAarti from "@/assets/graphics/features/avatar-aarti.png";
import avatarJohn2 from "@/assets/graphics/features/avatar-john-2.png";
import cart from "@/assets/graphics/hero/cart.svg";
import brand from "@/assets/graphics/features/brand.svg";
import notice from "@/assets/graphics/features/notice.svg";
import productSocks from "@/assets/graphics/features/product-socks.png";
import productShoes from "@/assets/graphics/features/product-shoes.png";
import paymentDetails from "@/assets/graphics/features/payment-details.svg";
import card1 from "@/assets/graphics/features/card-1.svg";
import card2 from "@/assets/graphics/features/card-2.svg";
import card3 from "@/assets/graphics/features/card-3.svg";
import chevron from "@/assets/graphics/features/chevron.svg";
import checkbox from "@/assets/graphics/features/checkbox.svg";
import shield from "@/assets/graphics/features/shield.svg";
import pieChart from "@/assets/graphics/features/pie-chart.svg";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Which mock interface to draw. */
  variant: "policy" | "checkout" | "payment" | "compliance";
};

const { render = true, variant, class: className, ...rest } = Astro.props;

const policies = [
  {
    icon: policyApproved,
    avatar: avatarJohn,
    name: "John Doe",
    accounts: "1 linked account",
    tone: "completed",
    status: "Completed",
  },
  {
    icon: policyBlocked,
    avatar: avatarAarti,
    name: "Aarti Shukla",
    accounts: "3 linked accounts",
    tone: "blocked",
    status: "Blocked",
  },
  {
    icon: policyPending,
    avatar: avatarJohn2,
    name: "John Doe",
    accounts: "1 linked account",
    tone: "processing",
    status: "Processing",
  },
];

const products = [
  { image: productSocks, name: "Cotton Everyday Socks", price: "$5.00" },
  { image: productShoes, name: "Ura Walking Shoes", price: "$150.00" },
];

const totals = [
  ["Subtotal", "$40.00 USD"],
  ["Discounts", "+$2.50 USD"],
  ["Taxes @9.25%", "+$3.70 USD"],
];

const fields = [
  { value: "First Name" },
  { value: "Last Name" },
  { value: "1234 1234 1234 1234", cards: true },
  { value: "MM / YY" },
  { value: "CVC" },
  { value: "United States", select: true },
  { value: "12345" },
];

const chart = [74, 106, 57, 34, 70, 106, 77, 54, 39, 12, 63];
---

{
  render && variant && (
    <div
      class:list={["feature-graphic_wrap", variant, className]}
      aria-hidden="true"
      {...rest}
    >
      <div class="feature-graphic_board">
        {variant === "policy" && (
          <>
            <div class="feature-graphic_thread" data-motion="draw" />
            <div class="feature-graphic_stack">
              {policies.map((policy) => (
                <div class="feature-graphic_card" data-motion="slide">
                  <div class="feature-graphic_entry">
                    <div
                      class:list={["feature-graphic_tile", policy.tone]}
                      data-motion="pop"
                    >
                      <Icon src={policy.icon} />
                    </div>
                    <div class="feature-graphic_body">
                      <div class="feature-graphic_line between">
                        <span class="feature-graphic_person">
                          <Img
                            class="feature-graphic_avatar"
                            src={policy.avatar}
                            variant="densities"
                            width={15}
                            height={15}
                          />
                          {policy.name}
                        </span>
                        <span
                          class="feature-graphic_bar faint"
                          style="--_w: 48"
                        />
                      </div>
                      <span class="feature-graphic_bar" style="--_w: 131" />
                      <div class="feature-graphic_line between">
                        <span class="feature-graphic_line">
                          <span class="feature-graphic_pill">
                            {policy.tone === "blocked" && (
                              <Icon
                                class="feature-graphic_danger"
                                src={danger}
                              />
                            )}
                            {policy.accounts}
                          </span>
                          <span class="feature-graphic_pill id">747498</span>
                        </span>
                        <span
                          class:list={["feature-graphic_pill", policy.tone]}
                          data-motion="pop"
                        >
                          {policy.status}
                        </span>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <div class="feature-graphic_entry feature-graphic_next">
              <div class="feature-graphic_tile small blocked">
                <Icon src={policyBlockedSmall} />
              </div>
              <div class="feature-graphic_body">
                <div class="feature-graphic_line between">
                  <span class="feature-graphic_person">
                    <Img
                      class="feature-graphic_avatar"
                      src={avatarAarti}
                      variant="densities"
                      width={15}
                      height={15}
                    />
                    Aarti Shukla
                  </span>
                  <span class="feature-graphic_bar faint" style="--_w: 48" />
                </div>
                <span class="feature-graphic_bar" style="--_w: 131" />
              </div>
            </div>
          </>
        )}
        {variant === "checkout" && (
          <>
            <div class="feature-graphic_notice" data-motion="drop">
              <Icon class="feature-graphic_check" src={notice} />
              Your order has been placed
              <span class="feature-graphic_ghost" />
            </div>
            <div class="feature-graphic_card feature-graphic_sheet" data-motion="rise">
              <div class="feature-graphic_line between">
                <span class="feature-graphic_title">
                  <Icon src={cart} />
                  Checkout
                </span>
                <span class="feature-graphic_pill id large">
                  <Icon src={brand} />
                  Brand Name
                </span>
              </div>
              <div class="feature-graphic_box">
                {products.map((product) => (
                  <div class="feature-graphic_product" data-motion="slide">
                    <div class="feature-graphic_thumb">
                      <Img
                        src={product.image}
                        variant="densities"
                        width={32}
                        height={32}
                      />
                      <span class="feature-graphic_count">1</span>
                    </div>
                    <div class="feature-graphic_body">
                      <span>{product.name}</span>
                      <span class="feature-graphic_bar" style="--_w: 131" />
                    </div>
                    <span class="feature-graphic_price">{product.price}</span>
                  </div>
                ))}
                <div class="feature-graphic_totals">
                  {totals.map(([label, value]) => (
                    <div class="feature-graphic_line between" data-motion="lift">
                      <span>{label}</span>
                      <strong>{value}</strong>
                    </div>
                  ))}
                </div>
                <div
                  class="feature-graphic_line between feature-graphic_total"
                  data-motion="lift"
                >
                  <span>HSA/FSA Total</span>
                  <strong>$41.20 USD</strong>
                </div>
              </div>
            </div>
          </>
        )}
        {variant === "payment" && (
          <>
            <div class="feature-graphic_card feature-graphic_sheet" data-motion="rise">
              <span class="feature-graphic_title">
                <Icon src={paymentDetails} />
                Payment Details
              </span>
              <div class="feature-graphic_box">
                <div class="feature-graphic_fields">
                  {fields.map((field, index) => (
                    <div
                      class:list={["feature-graphic_field", field.cards && "wide"]}
                      data-motion="drop"
                    >
                      <span class="feature-graphic_bar" style="--_w: 64" />
                      <span class="feature-graphic_input">
                        {field.value}
                        {field.cards && (
                          <span class="feature-graphic_line feature-graphic_cards">
                            <Icon src={card1} />
                            <Icon src={card2} />
                            <Icon src={card3} />
                          </span>
                        )}
                        {field.select && (
                          <Icon class="feature-graphic_chevron" src={chevron} />
                        )}
                      </span>
                    </div>
                  ))}
                </div>
                <div class="feature-graphic_line feature-graphic_terms" data-motion="lift">
                  <Icon src={checkbox} />
                  <span class="feature-graphic_body">
                    <span class="feature-graphic_bar" style="--_w: 166" />
                    <span class="feature-graphic_bar" style="--_w: 82" />
                  </span>
                </div>
                <div class="feature-graphic_action" data-motion="lift">Pay Now</div>
              </div>
            </div>
            <Img
              class="feature-graphic_shield"
              data-motion="spin"
              src={shield}
              width={67}
              height={78}
              transparent
            />
          </>
        )}
        {variant === "compliance" && (
          <>
            <div class="feature-graphic_notice" data-motion="drop">
              <Icon class="feature-graphic_check" src={notice} />
              Products launched only in the approved locations
            </div>
            <div class="feature-graphic_card feature-graphic_sheet" data-motion="rise">
              <div class="feature-graphic_entry">
                <div class="feature-graphic_tile" data-motion="pop">
                  <Icon src={pieChart} />
                </div>
                <div class="feature-graphic_body">
                  <div class="feature-graphic_line between">
                    <span class="feature-graphic_line">
                      <strong>Comparative Analysis</strong>
                      <span class="feature-graphic_pill">Vendor</span>
                    </span>
                    <span class="feature-graphic_bar faint" style="--_w: 48" />
                  </div>
                  <span class="feature-graphic_bar" style="--_w: 171" />
                  <span class="feature-graphic_bar" style="--_w: 93" />
                </div>
              </div>
              <div class="feature-graphic_rule" />
              <div class="feature-graphic_line between">
                <span class="feature-graphic_line">
                  <strong>Launch - Fall Season 2025</strong>
                  <span class="feature-graphic_pill">March 2025</span>
                </span>
                <span class="feature-graphic_bar faint" style="--_w: 48" />
              </div>
              <div class="feature-graphic_chart" data-motion="rise">
                <div class="feature-graphic_columns">
                  {chart.map((height, index) => (
                    <span
                      class:list={[index === 1 && "peak"]}
                      style={`--_h: ${height}`}
                      data-motion="grow"
                    />
                  ))}
                </div>
                <div class="feature-graphic_body">
                  <span class="feature-graphic_line">
                    <span class="feature-graphic_key" />
                    <span class="feature-graphic_bar thin" style="--_w: 23" />
                  </span>
                  <span class="feature-graphic_line">
                    <span class="feature-graphic_key faint" />
                    <span class="feature-graphic_bar thin" style="--_w: 23" />
                  </span>
                  <span class="feature-graphic_caption">Analysis</span>
                  <span class="feature-graphic_bar faint" style="--_w: 48" />
                  <span class="feature-graphic_bar" style="--_w: 83" />
                  <span class="feature-graphic_bar" style="--_w: 45" />
                  <span class="feature-graphic_bar faint" style="--_w: 31" />
                  <span class="feature-graphic_pill">Learn More</span>
                </div>
              </div>
            </div>
          </>
        )}
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Artboard */
    .feature-graphic_wrap {
      --_u: calc(100cqw / 414);
      --_completed: #157a66;
      --_blocked: #cc2e46;
      --_processing: #ad7e09;
      container-type: inline-size;
      width: 100%;
      max-width: 25.875rem;
      aspect-ratio: 414 / 371;
      & .completed {
        --_tone: var(--_completed);
      }
      & .blocked {
        --_tone: var(--_blocked);
      }
      & .processing {
        --_tone: var(--_processing);
      }
    }

    .feature-graphic_board {
      position: relative;
      height: 100%;
      overflow: clip;
      background-image: linear-gradient(var(--orange-100), var(--orange-50));
      border: var(--border-width) solid var(--border);
      border-radius: calc(var(--_u) * 20);
      color: var(--neutral-900);
      font-size: calc(var(--_u) * 10.7);
      font-weight: var(--primary-medium);
      line-height: 1.2;
      letter-spacing: -0.01em;
      &::before,
      &::after {
        position: absolute;
        z-index: 1;
        inset: auto 0 0;
        height: calc(var(--_u) * 64);
        background-image: linear-gradient(transparent, var(--orange-50));
      }
      &::after {
        content: "";
      }
      .policy &::before {
        content: "";
        inset: 0 0 auto;
        background-image: linear-gradient(var(--orange-100), transparent);
      }
    }

    /* Shared parts */
    .feature-graphic_card {
      padding: calc(var(--_u) * 12);
      background-image: linear-gradient(var(--orange-50), var(--white));
      border: var(--border-width) solid var(--orange-100);
      border-radius: calc(var(--_u) * 12);
      box-shadow:
        inset 0 0 0 calc(var(--_u) * 4) var(--white),
        0 calc(var(--_u) * 3) calc(var(--_u) * 6)
          color-mix(in lab, var(--neutral-200) 60%, transparent),
        0 calc(var(--_u) * 12) calc(var(--_u) * 24)
          color-mix(in lab, var(--neutral-600) 14%, transparent),
        0 calc(var(--_u) * 18) calc(var(--_u) * 36)
          color-mix(in lab, var(--neutral-700) 10%, transparent);
    }

    .feature-graphic_entry {
      display: flex;
      align-items: center;
      gap: calc(var(--_u) * 12);
    }

    .feature-graphic_body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: calc(var(--_u) * 7.5);
      min-width: 0;
    }

    .feature-graphic_line {
      display: flex;
      align-items: center;
      gap: calc(var(--_u) * 4);
      &.between {
        justify-content: space-between;
      }
    }

    .feature-graphic_tile {
      --_tone: var(--orange-500);
      flex: none;
      display: grid;
      place-items: center;
      width: calc(var(--_u) * 56);
      height: calc(var(--_u) * 56);
      background-color: color-mix(in lab, var(--_tone) 8%, var(--white));
      border: var(--border-width) solid
        color-mix(in lab, var(--_tone) 12%, var(--white));
      border-radius: calc(var(--_u) * 8);
      & .icon {
        --_size: calc(var(--_u) * 33);
      }
      &.small {
        width: calc(var(--_u) * 32);
        height: calc(var(--_u) * 32);
        border-radius: calc(var(--_u) * 6);
        & .icon {
          --_size: calc(var(--_u) * 19);
        }
      }
    }

    .feature-graphic_person {
      display: flex;
      align-items: center;
      gap: calc(var(--_u) * 4);
      color: var(--neutral-800);
    }

    .feature-graphic_avatar {
      width: calc(var(--_u) * 14.4);
      height: calc(var(--_u) * 14.4);
      border-radius: 50%;
    }

    .feature-graphic_bar {
      flex: none;
      display: block;
      width: calc(var(--_u) * var(--_w));
      max-width: 100%;
      height: calc(var(--_u) * 6);
      background-color: var(--neutral-200);
      border-radius: var(--radius-round);
      &.faint {
        opacity: 0.5;
      }
    }

    .feature-graphic_pill {
      --_tone: var(--neutral-900);
      display: flex;
      align-items: center;
      gap: calc(var(--_u) * 3.8);
      min-height: calc(var(--_u) * 17);
      padding-inline: calc(var(--_u) * 7.5);
      background-color: var(--white);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-round);
      color: var(--_tone);
      font-size: calc(var(--_u) * 8);
      white-space: nowrap;
      &.id {
        background-color: var(--neutral-100);
      }
      &.large {
        min-height: calc(var(--_u) * 20);
        font-size: calc(var(--_u) * 10);
        font-weight: var(--primary-regular);
        & .icon {
          --_size: calc(var(--_u) * 12);
        }
      }
      &:is(.completed, .blocked, .processing) {
        background-image: linear-gradient(
          transparent 24%,
          color-mix(in lab, var(--_tone) 14%, transparent)
        );
        border-color: color-mix(in lab, var(--_tone) 28%, transparent);
      }
    }

    .feature-graphic_danger.icon {
      --_size: calc(var(--_u) * 9);
      aspect-ratio: auto;
    }

    .feature-graphic_notice {
      position: absolute;
      top: calc(var(--_u) * 42);
      left: 50%;
      display: flex;
      align-items: center;
      gap: calc(var(--_u) * 6);
      padding: calc(var(--_u) * 6) calc(var(--_u) * 12);
      background-image: linear-gradient(var(--orange-50), var(--white));
      border: var(--border-width) solid var(--orange-100);
      border-radius: calc(var(--_u) * 12);
      box-shadow:
        inset 0 0 0 calc(var(--_u) * 4) var(--white),
        0 calc(var(--_u) * 3) calc(var(--_u) * 6)
          color-mix(in lab, var(--neutral-200) 60%, transparent);
      color: var(--neutral-1000);
      font-size: calc(var(--_u) * 12);
      line-height: 1.25;
      white-space: nowrap;
      translate: -50% 0;
      & .icon {
        --_size: calc(var(--_u) * 13.8);
      }
      .checkout & {
        width: calc(var(--_u) * 275);
      }
    }

    .feature-graphic_ghost {
      width: calc(var(--_u) * 65);
      height: calc(var(--_u) * 17);
      margin-left: auto;
      background-color: var(--white);
      background-image: linear-gradient(var(--neutral-600), var(--neutral-600));
      background-position: center;
      background-repeat: no-repeat;
      background-size: calc(var(--_u) * 49) calc(var(--_u) * 7);
      border: var(--border-width) solid var(--neutral-600);
      border-radius: calc(var(--_u) * 6.5);
      opacity: 0.32;
    }

    .feature-graphic_sheet {
      position: absolute;
      top: calc(var(--_u) * 83);
      left: calc(var(--_u) * 47);
      display: flex;
      flex-direction: column;
      gap: calc(var(--_u) * 12);
      width: calc(var(--_u) * 317);
      & strong {
        font-weight: var(--primary-bold);
      }
    }

    .feature-graphic_title {
      display: flex;
      align-items: center;
      gap: calc(var(--_u) * 5.6);
      color: var(--neutral-800);
      font-size: calc(var(--_u) * 12.2);
      font-weight: var(--primary-bold);
      & .icon {
        --_size: calc(var(--_u) * 16);
      }
    }

    .feature-graphic_box {
      display: flex;
      flex-direction: column;
      gap: calc(var(--_u) * 16);
      padding: calc(var(--_u) * 12) calc(var(--_u) * 8);
      border: var(--border-width) solid var(--border);
      border-radius: calc(var(--_u) * 6);
      color: var(--neutral-800);
    }

    /* Checkout */
    .feature-graphic_product {
      display: flex;
      align-items: flex-start;
      gap: calc(var(--_u) * 14);
      padding-bottom: calc(var(--_u) * 14);
      border-bottom: var(--border-width) solid var(--border);
      font-size: calc(var(--_u) * 11);
    }

    .feature-graphic_thumb {
      position: relative;
      flex: none;
      width: calc(var(--_u) * 32);
      height: calc(var(--_u) * 32);
      & .image {
        width: 100%;
        height: 100%;
        border: var(--border-width) solid var(--border);
        border-radius: calc(var(--_u) * 7);
      }
    }

    .feature-graphic_count {
      position: absolute;
      top: calc(var(--_u) * 17);
      left: calc(var(--_u) * 17);
      display: grid;
      place-items: center;
      width: calc(var(--_u) * 19.6);
      height: calc(var(--_u) * 20.5);
      background-color: var(--white);
      border: var(--border-width) solid var(--border);
      border-radius: calc(var(--_u) * 7);
      font-size: calc(var(--_u) * 9);
    }

    .feature-graphic_price {
      font-size: calc(var(--_u) * 12.5);
    }

    .feature-graphic_totals {
      display: flex;
      flex-direction: column;
      gap: calc(var(--_u) * 5);
      font-size: calc(var(--_u) * 10);
    }

    .feature-graphic_total {
      min-height: calc(var(--_u) * 42);
      padding-inline: calc(var(--_u) * 8);
      background-color: var(--white);
      border-radius: calc(var(--_u) * 8);
      font-size: calc(var(--_u) * 10);
    }

    /* Payment */
    .payment .feature-graphic_sheet {
      top: calc(var(--_u) * 47);
      left: calc(var(--_u) * 48.5);
      height: calc(var(--_u) * 330);
      overflow: clip;
    }

    .payment .feature-graphic_box {
      gap: calc(var(--_u) * 14);
      padding: calc(var(--_u) * 12);
      border-radius: calc(var(--_u) * 8);
    }

    .feature-graphic_fields {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: calc(var(--_u) * 14) calc(var(--_u) * 12);
    }

    .feature-graphic_field {
      display: flex;
      flex-direction: column;
      gap: calc(var(--_u) * 7);
      &.wide {
        grid-column: 1 / -1;
      }
    }

    .feature-graphic_input {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: calc(var(--_u) * 26.3);
      padding-inline: calc(var(--_u) * 7);
      background-color: var(--white);
      border: var(--border-width) solid var(--border);
      border-radius: calc(var(--_u) * 4.6);
      font-weight: var(--primary-regular);
    }

    .feature-graphic_cards {
      gap: calc(var(--_u) * 3);
      & .icon {
        --_size: calc(var(--_u) * 28.9);
        aspect-ratio: auto;
      }
    }

    .feature-graphic_chevron.icon {
      --_size: calc(var(--_u) * 5);
      aspect-ratio: auto;
      rotate: -90deg;
    }

    .feature-graphic_terms {
      gap: calc(var(--_u) * 8.8);
      & .icon {
        --_size: calc(var(--_u) * 15.8);
      }
      & .feature-graphic_body {
        gap: calc(var(--_u) * 6);
        opacity: 0.5;
      }
    }

    .feature-graphic_action {
      padding: calc(var(--_u) * 8) calc(var(--_u) * 12);
      background-color: var(--orange-300);
      background-image: linear-gradient(
        transparent 24%,
        color-mix(in lab, var(--orange-700) 25%, transparent)
      );
      border: var(--border-width) solid
        color-mix(in lab, var(--orange-700) 30%, transparent);
      border-radius: calc(var(--_u) * 8);
      color: var(--neutral-1000);
