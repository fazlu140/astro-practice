---
import type { HTMLAttributes } from "astro/types";
import Paragraph from "@/components/typography/Paragraph.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
};

const { render = true, class: className, ...rest } = Astro.props;

const caption = await slotContent(Astro.slots);
const logos = await slotContent(Astro.slots, "logos");
---

{
  render && logos && (
    <div class:list={["logo-strip_wrap", "margin-trim", className]} {...rest}>
      {caption && (
        <Paragraph variant="large" class="logo-strip_caption">
          <Fragment set:html={caption} />
        </Paragraph>
      )}
      <div class="logo-strip_list">
        <Fragment set:html={logos} />
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .logo-strip_wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-5);
      width: 100%;
      text-align: center;
    }

    .logo-strip_caption {
      color: var(--text-2);
      & strong {
        font-weight: var(--primary-bold);
      }
    }

    .logo-strip_list {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: var(--space-5) var(--space-6);
      width: 100%;
      max-width: 52rem;
      @media (width >= 48rem) {
        justify-content: space-between;
      }
      & > .image {
        flex: none;
        width: auto;
        transition:
          opacity 300ms var(--hover-ease),
          translate 300ms var(--hover-ease);
      }
      @media (hover: hover) {
        &:hover > .image:not(:hover) {
          opacity: 0.45;
        }
        & > .image:hover {
          translate: 0 -0.125rem;
        }
      }
    }
  }
</style>
