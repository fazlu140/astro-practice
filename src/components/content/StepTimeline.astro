---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/typography/Heading.astro";
import Icon from "@/components/media/Icon.astro";
import mark from "@/assets/logo/acerna-mark.svg";
import check from "@/assets/icons/check.svg";

type Step = {
  /** Point on the timeline, such as `Week 2`. */
  label: string;
  /** Step title. */
  heading: string;
  /** Checklist items. */
  points: string[];
};

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Steps in order. */
  steps: Step[];
};

const { render = true, steps = [], class: className, ...rest } = Astro.props;
---

{
  render && steps.length > 0 && (
    <div
      class:list={["step-timeline_wrap", className]}
      style={`--_count: ${steps.length}`}
      data-motion-scope
      {...rest}
    >
      <div class="step-timeline_track" data-motion aria-hidden="true">
        <span class="step-timeline_line" />
        <span class="step-timeline_fill" />
        <span class="step-timeline_marker">
          <Icon src={mark} />
        </span>
      </div>
      {steps.map((step, index) => (
        <div class="step-timeline_item" style={`--_n: ${index + 1}`}>
          <span class="step-timeline_chip" data-motion>
            {step.label}
          </span>
          <span class="step-timeline_stop" data-motion aria-hidden="true" />
          <div class="step-timeline_card margin-trim" data-motion>
            <Heading tag="h3" variant="h6">
              {step.heading}
            </Heading>
            <ul class="step-timeline_points" role="list">
              {step.points.map((point) => (
                <li>
                  <span class="step-timeline_tick">
                    <Icon src={check} />
                  </span>
                  {point}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  )
}

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ready } from "@/utils/motion.ts";

  gsap.registerPlugin(ScrollTrigger);

  const motion = "(prefers-reduced-motion: no-preference)";

  document
    .querySelectorAll<HTMLElement>(".step-timeline_wrap")
    .forEach((wrap) => {
      const find = gsap.utils.selector(wrap);
      const track = find(".step-timeline_track")[0] as HTMLElement;
      const line = find(".step-timeline_line");
      const fill = find(".step-timeline_fill");
      const marker = find(".step-timeline_marker");
      const items = find(".step-timeline_item") as HTMLElement[];
      const stops = find(".step-timeline_stop") as HTMLElement[];
      const ticked = items.map(() => false);
      const media = gsap.matchMedia();
      let current = -1;

      const tick = (index: number) => {
        ticked[index] = true;
        gsap.fromTo(
          items[index].querySelectorAll(".step-timeline_tick"),
          { scale: 0 },
          {
            scale: 1,
            duration: 0.4,
            ease: "back.out(2.4)",
            stagger: 0.07,
            overwrite: true,
          },
        );
      };

      const activate = (index: number) =>
        items.forEach((item, step) =>
          item.classList.toggle("active", step === index),
        );

      media.add(motion, () => {
        ready(wrap);
        gsap.set(find(".step-timeline_tick"), { scale: 0 });
        gsap.set(fill, { scaleX: 0, scaleY: 0, transformOrigin: "0 0" });
        return () => {
          current = -1;
          ticked.fill(false);
          activate(-1);
        };
      });

      /* Side by side: play once when the section arrives */
      media.add(`${motion} and (min-width: 48rem)`, () => {
        const go = (index: number, duration = 0.65) => {
          const box = track.getBoundingClientRect();
          const stop = stops[index].getBoundingClientRect();
          const x = stop.left + stop.width / 2 - box.left;
          const moved = index !== current;
          current = index;
          ticked.forEach((done, step) => {
            if (!done && step < index) tick(step);
          });
          gsap.to(marker, {
            x,
            y: 0,
            duration,
            ease: "power2.inOut",
            overwrite: true,
          });
          gsap.to(fill, {
            scaleX: x / box.width,
            scaleY: 1,
            duration,
            ease: "power2.inOut",
            overwrite: true,
          });
          gsap.delayedCall(duration * 0.7, () => {
            if (moved || !ticked[index]) tick(index);
            if (current === index) activate(index);
          });
        };

        const play = () => {
          const intro = gsap.timeline({ defaults: { ease: "power3.out" } });
          intro
            .fromTo(
              find(".step-timeline_chip"),
              { autoAlpha: 0, scale: 0.6 },
              {
                autoAlpha: 1,
                scale: 1,
                duration: 0.5,
                ease: "back.out(2)",
                stagger: 0.07,
              },
              0,
            )
            .set(track, { autoAlpha: 1 }, 0.1)
            .fromTo(
              [...line, ...marker, ...stops],
              { autoAlpha: 0 },
              { autoAlpha: 1, duration: 0.4, stagger: 0.05 },
              0.1,
            )
            .fromTo(
              find(".step-timeline_card"),
              { autoAlpha: 0, y: 28 },
              { autoAlpha: 1, y: 0, duration: 0.6, stagger: 0.07 },
              0.15,
            )
            .add(() => go(0, 0.01), 0.45);
          items.slice(1).forEach((_, index) => {
            intro.add(() => go(index + 1), 1.2 + index * 0.9);
          });
        };

        ScrollTrigger.create({
          trigger: wrap,
          start: "top 75%",
          once: true,
          onEnter: play,
        });

        const settle = () => current >= 0 && go(current, 0.01);
        window.addEventListener("resize", settle);
        return () => window.removeEventListener("resize", settle);
      });

      /* Stacked: the marker follows the scroll */
      media.add(`${motion} and (max-width: 47.99rem)`, () => {
        const first = stops[0];
        const last = stops[stops.length - 1];
        let offsets: number[] = [];

        const measure = () => {
          const base = first.getBoundingClientRect().top;
          offsets = stops.map((stop) => stop.getBoundingClientRect().top - base);
        };
        const distance = () => offsets[offsets.length - 1] ?? 0;

        const reach = (progress: number) => {
          const travelled = progress * distance();
          let index = 0;
          offsets.forEach((offset, step) => {
            if (travelled >= offset - 2) index = step;
          });
          if (index === current) return;
          current = index;
          activate(index);
          ticked.forEach((done, step) => {
            if (!done && step <= index) tick(step);
          });
        };

        measure();
        gsap.set(track, { autoAlpha: 1 });
        gsap.set(fill, { scaleX: 1, scaleY: 0 });

        gsap.fromTo(
          [...line, ...marker],
          { autoAlpha: 0 },
          {
            autoAlpha: 1,
            duration: 0.4,
            scrollTrigger: { trigger: wrap, start: "top 85%", once: true },
          },
        );

        items.forEach((item, index) => {
          ScrollTrigger.create({
            trigger: item,
            start: "top 85%",
            once: true,
            onEnter: () => {
              gsap.fromTo(
                item.querySelectorAll(
                  ".step-timeline_chip, .step-timeline_stop, .step-timeline_card",
                ),
                { autoAlpha: 0, y: 20 },
                {
                  autoAlpha: 1,
                  y: 0,
                  duration: 0.6,
                  ease: "power3.out",
                  stagger: 0.06,
                },
              );
              if (index === 0) reach(0);
            },
          });
        });

        gsap
          .timeline({
            defaults: { ease: "none" },
            scrollTrigger: {
              trigger: first,
              start: "center 45%",
              endTrigger: last,
              end: "center 45%",
              scrub: 0.4,
              invalidateOnRefresh: true,
              onRefresh: measure,
              onUpdate: (self) => reach(self.progress),
            },
          })
          .to(marker, { x: 0, y: () => distance() }, 0)
          .to(
            fill,
            {
              scaleY: () => distance() / track.getBoundingClientRect().height,
            },
            0,
          );
      });
    });
</script>

<style is:global>
  @layer components {
    .step-timeline_wrap {
      --_ease: cubic-bezier(0.2, 0.7, 0.2, 1);
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      width: 100%;
      @media (width >= 48rem) {
        display: grid;
        grid-template-columns: repeat(var(--_count), minmax(0, 1fr));
        gap: var(--space-6) var(--space-4);
      }
    }

    /* Track */
    .step-timeline_track {
      position: absolute;
      top: 1.125rem;
      bottom: 0;
      left: 1rem;
      width: 0.25rem;
      border-radius: var(--radius-round);
      @media (width >= 48rem) {
        position: relative;
        inset: auto;
        grid-area: 2 / 1 / 3 / -1;
        align-self: center;
        width: auto;
        height: 0.25rem;
        margin-inline: calc(
          (100% - (var(--_count) - 1) * var(--space-4)) / var(--_count) / 2
        );
      }
    }

    .step-timeline_line,
    .step-timeline_fill {
      position: absolute;
      inset: 0;
      background-color: var(--border);
      border-radius: inherit;
    }

    .step-timeline_fill {
      background-color: var(--orange-300);
    }

    .step-timeline_marker {
      position: absolute;
      z-index: 2;
      top: 0;
      left: 50%;
      display: grid;
      place-items: center;
      width: 2.25rem;
      height: 2.25rem;
      background-color: var(--white);
      border: var(--border-width) solid var(--orange-100);
      border-radius: var(--radius-small);
      box-shadow:
        0 0.1875rem 0.375rem
          color-mix(in lab, var(--neutral-200) 60%, transparent),
        0 1.125rem 2.25rem
          color-mix(in lab, var(--neutral-700) 8%, transparent);
      color: var(--orange-500);
      translate: -50% -50%;
      @media (width >= 48rem) {
        top: 50%;
        left: 0;
      }
    }

    /* Steps */
    .step-timeline_item {
      display: grid;
      grid-template-columns: 2.25rem minmax(0, 1fr);
      align-items: center;
      gap: var(--space-3);
      @media (width >= 48rem) {
        display: contents;
      }
    }

    .step-timeline_stop {
      position: relative;
      z-index: 1;
      grid-area: 1 / 1;
      justify-self: center;
      width: 0.75rem;
      height: 0.75rem;
      background-color: var(--neutral-1000);
      border-radius: 0.125rem;
      transition: scale 300ms var(--_ease);
      .active > & {
        scale: 1.35;
      }
      @media (width >= 48rem) {
        grid-area: 2 / var(--_n);
        align-self: center;
      }
    }

    .step-timeline_chip {
      position: relative;
      grid-area: 1 / 2;
      justify-self: start;
      padding: 0.5rem 0.75rem;
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
      color: var(--text-2);
      font-weight: var(--primary-medium);
      line-height: var(--line-height-large);
      transition: translate 300ms var(--_ease);
      &::after {
        content: "";
        position: absolute;
        inset: calc(var(--border-width) * -1);
        background-color: color-mix(in lab, var(--orange-300) 18%, transparent);
        border: var(--border-width) solid var(--orange-300);
        border-radius: inherit;
        opacity: 0;
        transition: opacity 300ms var(--hover-ease);
      }
      .active > & {
        translate: 0 -0.125rem;
        &::after {
          opacity: 1;
        }
      }
      @media (width >= 48rem) {
        grid-area: 1 / var(--_n);
        justify-self: center;
      }
    }

    .step-timeline_card {
      position: relative;
      grid-area: 2 / 2;
      padding: var(--space-5);
      background-color: var(--white);
      border: var(--border-width) solid var(--orange-100);
      border-radius: var(--radius-large);
      box-shadow:
        inset 0 0 0 0.25rem var(--white),
        0 0.1875rem 0.375rem
          color-mix(in lab, var(--neutral-200) 60%, transparent),
        0 1.125rem 2.25rem
          color-mix(in lab, var(--neutral-700) 6%, transparent);
      transition: translate 400ms var(--_ease);
      &::after {
        content: "";
        position: absolute;
        inset: calc(var(--border-width) * -1);
        border: var(--border-width) solid var(--orange-300);
        border-radius: inherit;
        opacity: 0;
        pointer-events: none;
        transition: opacity 300ms var(--hover-ease);
      }
      .active > & {
        translate: 0 -0.375rem;
        &::after {
          opacity: 1;
        }
      }
      & .heading {
        margin-bottom: var(--space-3);
        color: var(--text-2);
      }
      @media (width >= 48rem) {
        grid-area: 3 / var(--_n);
      }
    }

    .step-timeline_points {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      margin: 0;
      padding: 0;
      color: var(--text-2);
      list-style: none;
      & li {
        display: flex;
        align-items: center;
        gap: var(--space-1);
      }
    }

    .step-timeline_tick {
      flex: none;
      display: grid;
      place-items: center;
      width: 1rem;
      height: 1rem;
      background-color: var(--orange-300);
      border-radius: 50%;
      color: var(--white);
      box-shadow: 0 0 0 var(--border-width) var(--orange-300);
      & .icon {
        --_size: 0.5rem;
        --border-width: 0.1rem;
        aspect-ratio: auto;
      }
    }
  }
</style>
