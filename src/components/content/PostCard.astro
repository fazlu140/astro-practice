---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import FormattedDate from "@/components/utility/FormattedDate.astro";
import arrow from "@/assets/icons/arrow.svg";

type Props = HTMLAttributes<"article"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Post title. */
  heading: string;
  /** Short excerpt. Shown on the featured layout only. */
  text?: string;
  /** Post destination. */
  href: string;
  /** Image source. */
  image?: ImageMetadata;
  /** Reading time, such as `12 min read`. */
  readTime?: string;
  /** Publish date. */
  date?: Date;
  /** Card layout. */
  variant?: "featured" | "compact";
  /** Heading level. */
  headingTag?: "h2" | "h3" | "h4" | "h5" | "h6";
};

const {
  render = true,
  heading,
  text,
  href,
  image,
  readTime,
  date,
  variant = "featured",
  headingTag = "h3",
  class: className,
  ...rest
} = Astro.props;

const compact = variant === "compact";
---

{
  render && heading && href && (
    <article
      class:list={["post-card_wrap", compact && "compact", className]}
      {...rest}
    >
      {image && (
        <div class="post-card_media">
          {compact ? (
            <Img
              src={image}
              variant="densities"
              width={133}
              height={133}
              data-motion="settle"
            />
          ) : (
            <Img
              src={image}
              variant="constrained"
              sizes="(min-width: 64rem) 30rem, 100vw"
              width={470}
              height={304}
              data-motion="settle"
            />
          )}
          <span class="post-card_badge" aria-hidden="true">
            <Icon src={arrow} variant="small" />
          </span>
        </div>
      )}
      <div class="post-card_content margin-trim">
        <Heading
          tag={headingTag}
          variant={compact ? "h6" : "h4"}
          class="post-card_title"
        >
          <a href={href}>{heading}</a>
        </Heading>
        {!compact && (
          <Paragraph class="post-card_text" variant="small">
            {text}
          </Paragraph>
        )}
        {(readTime || date) && (
          <p class="post-card_meta">
            {readTime && <span>{readTime}</span>}
            {readTime && date && <span aria-hidden="true">|</span>}
            {date && <FormattedDate date={date} format={{ dateStyle: "medium" }} />}
          </p>
        )}
      </div>
    </article>
  )
}

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    document
      .querySelectorAll<HTMLElement>(".post-card_wrap:not(.compact) .post-card_media")
      .forEach((media) => {
        gsap.fromTo(
          media.querySelector(".image"),
          { yPercent: -5 },
          {
            yPercent: 5,
            ease: "none",
            scrollTrigger: {
              trigger: media,
              start: "top bottom",
              end: "bottom top",
              scrub: 0.6,
            },
          },
        );
      });
  });
</script>

<style is:global>
  @layer components {
    .post-card_wrap {
      --_ease: cubic-bezier(0.2, 0.7, 0.2, 1);
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-2);
      background-color: var(--white);
      border: var(--border-width) solid var(--orange-100);
      border-radius: var(--radius-large);
      box-shadow:
        0 0.1875rem 0.375rem
          color-mix(in lab, var(--neutral-200) 60%, transparent),
        0 1.125rem 2.25rem
          color-mix(in lab, var(--neutral-700) 6%, transparent);
      transition: translate 400ms var(--_ease);
      &.compact {
        flex-direction: row;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-3);
      }
      @media (hover: hover) {
        &:hover {
          translate: 0 -0.25rem;
          & .post-card_media .image {
            scale: 1.05;
          }
          & .post-card_badge {
            opacity: 1;
            scale: 1;
          }
        }
      }
    }

    .post-card_media {
      position: relative;
      flex: none;
      aspect-ratio: 470 / 304;
      overflow: clip;
      background-color: var(--background-2);
      border-radius: var(--radius-main);
      .compact > & {
        width: clamp(6rem, 30%, 8.3125rem);
        aspect-ratio: 1;
      }
      & .image {
        position: absolute;
        top: -6%;
        left: 0;
        width: 100%;
        height: 112%;
        object-fit: cover;
        transition: scale 600ms var(--_ease);
      }
      .compact > & .image {
        top: 0;
        height: 100%;
      }
    }

    .post-card_badge {
      position: absolute;
      top: var(--space-2);
      right: var(--space-2);
      display: grid;
      place-items: center;
      width: 2.25rem;
      height: 2.25rem;
      background-color: var(--white);
      border-radius: 50%;
      color: var(--orange-700);
      opacity: 0;
      rotate: -45deg;
      scale: 0.6;
      transition:
        opacity 250ms var(--hover-ease),
        scale 300ms var(--_ease);
      .compact & {
        top: var(--space-1);
        right: var(--space-1);
        width: 1.75rem;
        height: 1.75rem;
      }
    }

    .post-card_content {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-width: 0;
      padding: var(--space-3);
      .compact > & {
        padding: 0;
      }
    }

    .post-card_title {
      margin-bottom: 1.25rem;
      .compact & {
        margin-bottom: 0;
      }
      & a {
        color: inherit;
        text-decoration: none;
        &::after {
          content: "";
          position: absolute;
          z-index: 1;
          inset: 0;
          border-radius: var(--radius-large);
        }
      }
    }

    .post-card_text {
      display: -webkit-box;
      overflow: hidden;
      color: var(--neutral-700);
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }

    .post-card_meta {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      margin: 2.25rem 0 0;
      color: var(--text-2);
      font-size: var(--text-small);
      line-height: var(--text-small-line-height);
      &::before,
      &::after {
        content: none;
      }
      .compact & {
        margin-top: 1.5rem;
      }
      & [aria-hidden] {
        color: var(--border);
      }
    }
  }
</style>
