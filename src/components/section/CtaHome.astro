---
import type { ComponentProps } from "astro/types";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import Button from "@/components/Button.astro";

type Props = Omit<
  ComponentProps<typeof Section>,
  | "theme"
  | "paddingTop"
  | "paddingBottom"
  | "gap"
  | "align"
  | "fullHeight"
  | "containerClass"
  | "containerAttrs"
> & {
  /** Heading text. */
  heading: string;
  /** Button label. Omit to render no button. */
  buttonText?: string;
  /** Button destination. */
  buttonHref?: string;
};

const {
  render = true,
  heading,
  buttonText,
  buttonHref = "/contact",
  class: className,
  ...rest
} = Astro.props;
---

{
  render && heading && (
    <Section
      class={["cta-home_wrap", className].filter(Boolean).join(" ")}
      theme="brand"
      paddingTop="large"
      paddingBottom="large"
      data-motion-scope="view"
      {...rest}
    >
      <div slot="background" class="cta-home_stage" aria-hidden="true">
        <div class="cta-home_glow" />
        <div class="cta-home_spot" />
        <div class="cta-home_dots" />
        <div class="cta-home_line" data-motion="draw" />
        <div class="cta-home_line" data-motion="draw" />
        <div class="cta-home_line across" data-motion="sweep" />
        <div class="cta-home_line across" data-motion="sweep" />
      </div>

      <ContentWrapper centered>
        <Heading tag="h2" maxWidth={24} data-motion="lines">
          {heading}
        </Heading>
        {buttonText && (
          <ButtonWrapper data-motion="pop">
            <Button element="link" href={buttonHref}>
              {buttonText}
            </Button>
          </ButtonWrapper>
        )}
      </ContentWrapper>
    </Section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>(".cta-home_wrap").forEach((wrap) => {
    wrap.addEventListener("pointermove", (event) => {
      const box = wrap.getBoundingClientRect();
      wrap.style.setProperty("--_x", `${event.clientX - box.left}px`);
      wrap.style.setProperty("--_y", `${event.clientY - box.top}px`);
    });
  });
</script>

<style is:global>
  @layer components {
    .cta-home_wrap {
      --_line: color-mix(in lab, var(--white) 35%, transparent);
      overflow: clip;
      @media (hover: hover) {
        &:hover .cta-home_spot {
          opacity: 1;
        }
      }
    }

    .cta-home_stage {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .cta-home_glow {
      position: absolute;
      inset: 0;
      background-image:
        radial-gradient(
          ellipse 55% 80% at 50% 0%,
          color-mix(in lab, var(--orange-700) 45%, transparent),
          transparent 70%
        ),
        radial-gradient(
          ellipse 50% 70% at 50% 100%,
          color-mix(in lab, var(--orange-300) 80%, transparent),
          transparent 70%
        );
    }

    .cta-home_spot {
      position: absolute;
      top: 0;
      left: 0;
      width: 28rem;
      height: 28rem;
      background-image: radial-gradient(
        circle closest-side,
        color-mix(in lab, var(--white) 22%, transparent),
        transparent
      );
      opacity: 0;
      translate: calc(var(--_x, 50%) - 50%) calc(var(--_y, 50%) - 50%);
      transition: opacity 400ms var(--hover-ease);
    }

    .cta-home_dots {
      position: absolute;
      inset: 45% 15% 0;
      background-image: radial-gradient(
        circle,
        color-mix(in lab, var(--white) 55%, transparent) 0.125rem,
        transparent 0.15rem
      );
      background-size: 0.875rem 0.875rem;
      mask-image: radial-gradient(
        ellipse 50% 100% at 50% 100%,
        black,
        transparent 75%
      );
    }

    .cta-home_line {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 15%;
      width: var(--border-width);
      background-color: var(--_line);
      & + & {
        left: 80%;
      }
      &.across {
        top: 26%;
        bottom: auto;
        left: 0;
        width: 15%;
        height: var(--border-width);
      }
      &.across + &.across {
        top: 75%;
        left: 80%;
        width: 20%;
      }
    }

    .cta-home_wrap {
      @media (prefers-reduced-motion: no-preference) {
        & .cta-home_glow {
          animation: cta-home-drift 14s ease-in-out infinite alternate;
        }
        & .cta-home_dots {
          animation: cta-home-shimmer 5s ease-in-out infinite alternate;
        }
      }
    }

    @keyframes cta-home-drift {
      from {
        translate: -4% 0;
      }
      to {
        translate: 4% 0;
      }
    }

    @keyframes cta-home-shimmer {
      to {
        opacity: 0.55;
        translate: 0 -0.375rem;
      }
    }
  }
</style>
