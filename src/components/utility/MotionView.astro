<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ready, reveal } from "@/utils/motion.ts";

  gsap.registerPlugin(ScrollTrigger);

  const idle = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) =>
        entry.target.toggleAttribute("data-idle", !entry.isIntersecting),
      );
    },
    { rootMargin: "200px 0px" },
  );
  document
    .querySelectorAll(".section, .footer_wrap")
    .forEach((section) => idle.observe(section));

  gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
    const scopes = gsap.utils.toArray<HTMLElement>(
      '[data-motion-scope="view"]',
    );
    scopes.forEach(ready);
    ScrollTrigger.batch(scopes, {
      start: "top 85%",
      once: true,
      onEnter: (batch) => {
        let visible = 0;
        batch.forEach((scope) => {
          const passed = scope.getBoundingClientRect().bottom < 0;
          if (passed) {
            reveal(scope as HTMLElement).progress(1);
            return;
          }
          reveal(scope as HTMLElement, { delay: Math.min(visible, 3) * 0.08 });
          visible += 1;
        });
      },
    });

    let timer = 0;
    const settle = () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => ScrollTrigger.refresh(), 350);
    };
    document.addEventListener("toggle", settle, true);

    requestAnimationFrame(() => {
      ScrollTrigger.sort();
      ScrollTrigger.refresh();
    });

    return () => {
      window.clearTimeout(timer);
      document.removeEventListener("toggle", settle, true);
    };
  });
</script>
