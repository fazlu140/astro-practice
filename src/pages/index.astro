---
import Layout from "@/layouts/BaseLayout.astro";
import FeatureSteps from "@/components/section/FeatureSteps.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Heading from "@/components/typography/Heading.astro";
import HeroHome from "@/components/section/HeroHome.astro";
import FeatureRow from "@/components/content/FeatureRow.astro";
import FeatureGraphic from "@/components/content/FeatureGraphic.astro";
import Section from "@/components/wrapper/Section.astro";
import Card from "@/components/item/Card.astro";
import BentoGrid from "@/components/content/BentoGrid.astro";
import BentoGraphic from "@/components/content/BentoGraphic.astro";
import MotionView from "@/components/utility/MotionView.astro";
import StepTimeline from "@/components/content/StepTimeline.astro";
import ProofGrid from "@/components/content/ProofGrid.astro";
import IntegrationCard from "@/components/content/IntegrationCard.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import fileText from "@/assets/graphics/features/icon-file-text.svg";
import clock from "@/assets/graphics/features/icon-clock.svg";
import clipboardClock from "@/assets/graphics/features/icon-clipboard-clock.svg";
---

<Layout title="The AI backbone for financial workflows" overlap>
  {/* Hero */}
  <HeroHome
    heading="The AI backbone for financial workflows."
    text="Unify compliance, approvals, and automation in one financial platform which is built to help you launch and scale securely."
  />

  {/* Features */}
  <FeatureSteps>
    <ContentWrapper slot="intro" centered>
      <Heading
        class="heading-accent"
        variant="h3"
        maxWidth={30}
        data-motion="lines"
      >
        <strong>Financial workflow controls</strong> that always run on autopilot.
      </Heading>
    </ContentWrapper>
    <FeatureRow
      heading="Set up smarter policy controls for transactions"
      text="Create approval flows once and let AI enforce them in real time — no chasing, no manual checks."
      icon={fileText}
      buttonText="Try Acerna Today"
    >
      <FeatureGraphic variant="policy" />
    </FeatureRow>
    <FeatureRow
      heading="Real-time security built into every transaction."
      text="Every payment auto-tracked and compliant — tax, policy, and approvals handled instantly."
      icon={clock}
      buttonText="Book A Demo"
    >
      <FeatureGraphic variant="checkout" />
    </FeatureRow>
    <FeatureRow
      heading="Simplified, automated checkout experience"
      text="Vendor bills and purchases processed safely before payments clear."
      icon={clipboardClock}
      buttonText="Talk With Our Team"
    >
      <FeatureGraphic variant="payment" />
    </FeatureRow>
    <FeatureRow
      heading="Ensure every launch is compliance-ready"
      text="Expand confidently — every campaign and region stays regulation-aligned."
      icon={clipboardClock}
      buttonText="Schedule a Demo"
    >
      <FeatureGraphic variant="compliance" />
    </FeatureRow>
  </FeatureSteps>

  {/* Bento */}
  <Section>
    <ContentWrapper centered data-motion-scope="view">
      <Heading
        class="heading-accent"
        variant="h3"
        maxWidth={30}
        data-motion="lines"
      >
        Where <strong>financial compliance</strong> meets workflow confidence.
      </Heading>
    </ContentWrapper>
    <BentoGrid>
      <Card
        variant="graphic"
        heading="Access &amp; Payouts"
        text="Automate, track, reconcile — from one smart dashboard."
        data-motion-scope="view"
        data-motion="rise"
      >
        <BentoGraphic variant="access" />
      </Card>
      <Card
        variant="graphic"
        heading="Workflow Process Automation"
        text="Reduce approvals by 80% as AI handles routine tasks."
        data-motion-scope="view"
        data-motion="rise"
      >
        <BentoGraphic variant="workflow" />
      </Card>
      <Card
        variant="graphic"
        heading="Launch Compliance"
        text="Approved markets, only."
        data-motion-scope="view"
        data-motion="rise"
      >
        <BentoGraphic variant="launch" />
      </Card>
      <Card
        variant="graphic"
        heading="Anxiety-free Growth"
        text="Get live compliance insights."
        data-motion-scope="view"
        data-motion="rise"
      >
        <BentoGraphic variant="growth" />
      </Card>
      <Card
        variant="graphic"
        heading="Unified System"
        text="Workflows, payments, unified."
        data-motion-scope="view"
        data-motion="rise"
      >
        <BentoGraphic variant="unified" />
      </Card>
    </BentoGrid>
  </Section>

  {/* How it works */}
  <Section>
    <ContentWrapper centered data-motion-scope="view">
      <Heading
        class="heading-accent"
        variant="h3"
        maxWidth={30}
        data-motion="lines"
      >
        Here’s what you can get done with acerna in <strong>4 weeks</strong>
      </Heading>
    </ContentWrapper>
    <StepTimeline
      steps={[
        {
          label: "Today",
          heading: "Get started",
          points: [
            "Connect your finance tools",
            "Import your existing policies",
            "Invite your approvers",
            "Map your first workflow",
          ],
        },
        {
          label: "Week 2",
          heading: "Get comfortable",
          points: [
            "Automate routine approvals",
            "Flag risky transactions",
            "Reconcile payouts daily",
            "Track every exception",
          ],
        },
        {
          label: "Week 4",
          heading: "Easier to switch",
          points: [
            "Retire manual checks",
            "Launch in new markets",
            "Export audit-ready reports",
            "Scale without extra headcount",
          ],
        },
      ]}
    />
  </Section>

  {/* Proof */}
  <Section class="background-2" containerClass="max-width-wide">
    <ContentWrapper centered data-motion-scope="view">
      <Heading
        class="heading-accent"
        variant="h3"
        maxWidth={30}
        data-motion="lines"
      >
        <strong>Proven financial workflow</strong> across every platform
      </Heading>
      <ButtonWrapper data-motion="pop">
        <Button element="link" href="/contact">Book a Consultation</Button>
      </ButtonWrapper>
    </ContentWrapper>
    <ProofGrid>
      <Card
        variant="quote"
        text="I wanted an AI-based call tracking service that would predict sales and provide feedback on my calls to increase my revenue, and I found just that in Acerna."
        cite="– Annia Mirza, Co-founder, Crestline Finance"
        buttonLabel="Read Case Study"
        buttonHref="/case-studies"
        accent
        data-motion-scope="view"
        data-motion="rise"
      />
      <Card
        variant="stat"
        value="80%"
        heading="Reduction in QA costs"
        text="in 3 months"
        data-motion-scope="view"
        data-motion="rise"
      />
      <Fragment slot="column2">
        <Card
          variant="stat"
          value="30%"
          heading="Reduction in QA costs"
          text="in 3 months"
          data-motion-scope="view"
          data-motion="rise"
        />
        <Card
          variant="quote"
          text="I wanted an AI-based call tracking service that would predict sales and provide feedback on my calls to increase my revenue, and I found just that in Acerna."
          cite="– Annia Mirza, Co-founder, Crestline Finance"
          buttonLabel="Read Case Study"
          buttonHref="/case-studies"
          data-motion-scope="view"
          data-motion="rise"
        />
      </Fragment>
      <Fragment slot="column3">
        <Card
          variant="quote"
          text="I wanted an AI-based call tracking service that would predict sales and provide feedback on my calls to increase my revenue, and I found just that in Acerna."
          cite="– Annia Mirza, Co-founder, Crestline Finance"
          buttonLabel="Read Case Study"
          buttonHref="/case-studies"
          data-motion-scope="view"
          data-motion="rise"
        />
        <Card
          variant="stat"
          value="25%"
          heading="Reduction in QA costs"
          text="in 3 months"
          data-motion-scope="view"
          data-motion="rise"
        />
      </Fragment>
    </ProofGrid>
  </Section>

  {/* Integrations */}
  <Section containerClass="max-width-wide">
    <ContentWrapper centered data-motion-scope="view">
      <Heading variant="h3" data-motion="lines">Discover All Connections</Heading>
    </ContentWrapper>
    <IntegrationCard
      heading="One place to plan smarter, track better, and pay easier."
      points={[
        "Monitor service costs in real-time",
        "Automate and schedule payments",
        "Manage all vendors and integrations, seamlessly",
      ]}
      buttonText="Explore All Integrations"
    />
  </Section>
  <MotionView />
</Layout>
